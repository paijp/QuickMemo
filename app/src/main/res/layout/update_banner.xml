<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/updateBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_update_banner"
    android:padding="12dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/updateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#E0E0E0"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnUpdateDetails"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/btn_update_details"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:backgroundTint="#2A2A3E"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/btn_update"
            android:textColor="#1A1A2E"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:backgroundTint="#5DCAA5"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp" />
    </LinearLayout>

</LinearLayout>
