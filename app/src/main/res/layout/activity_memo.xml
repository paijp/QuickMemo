<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A2E">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_quick_memo"
            android:textColor="#5DCAA5"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Input row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/memoInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_memo_input"
            android:hint="@string/memo_hint"
            android:textColorHint="#666666"
            android:textColor="#E0E0E0"
            android:textSize="15sp"
            android:paddingHorizontal="14dp"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/btn_save"
            android:textColor="#1A1A2E"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:backgroundTint="#5DCAA5"
            android:layout_marginStart="8dp"
            android:minWidth="72dp"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

    <!-- Keyword buttons bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/keywordContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/btnEditKeywords"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_edit"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:contentDescription="Edit keywords"
            android:layout_marginStart="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A3E"
        android:layout_marginHorizontal="16dp" />

    <!-- Scrollable: memo list + calendar -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Memo list -->
            <LinearLayout
                android:id="@+id/listContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <!-- Divider before calendar -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A2A3E"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="4dp" />

            <!-- Calendar (display only, compact) -->
            <CalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="16dp"
                android:dateTextAppearance="@style/CalendarDateText"
                android:weekDayTextAppearance="@style/CalendarWeekText"
                android:focusedMonthDateColor="#DDDDDD"
                android:unfocusedMonthDateColor="#555555"
                android:selectedWeekBackgroundColor="#2A2A3E"
                android:weekSeparatorLineColor="#2A2A3E"
                android:scaleY="0.85"
                android:transformPivotY="0dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
