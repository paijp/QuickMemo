<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuickMemo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#5DCAA5</item>
        <item name="colorPrimaryVariant">#1D9E75</item>
        <item name="colorOnPrimary">#1A1A2E</item>
        <item name="colorSecondary">#85B7EB</item>
        <item name="android:statusBarColor">#1A1A2E</item>
        <item name="android:navigationBarColor">#1A1A2E</item>
    </style>

    <style name="Theme.QuickMemo.Memo" parent="Theme.QuickMemo">
        <item name="android:windowBackground">#1A1A2E</item>
        <item name="android:windowIsTranslucent">false</item>
