    <style name="CalendarDateText" parent="android:TextAppearance.Small">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#DDDDDD</item>
    </style>

    <style name="CalendarWeekText" parent="android:TextAppearance.Small">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#DDDDDD</item>
    </style>
